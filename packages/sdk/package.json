{
  "name": "@app-passport/sdk",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Artifact-bound AI tool and Qarinah context passports with signed, independently readable Arkiv reviews.",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schemas"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./arkiv": {
      "types": "./dist/arkiv.d.ts",
      "import": "./dist/arkiv.js"
    },
    "./qarinah": {
      "types": "./dist/qarinah.d.ts",
      "import": "./dist/qarinah.js"
    }
  },
  "bin": {
    "app-passport": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/arkiv.ts src/qarinah.ts src/cli.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "viem": "2.57.5",
    "zod": "4.1.0"
  },
  "peerDependencies": {
    "qarinah": ">=0.6.0 <0.8.0"
  },
  "peerDependenciesMeta": {
    "qarinah": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "8.5.0"
  }
}
