{
  "name": "@ajnasnb/ai-passport",
  "version": "0.6.0",
  "type": "module",
  "license": "MIT",
  "description": "Signed Arkiv evidence graphs, AI tool/context admission and Qarinah adapters.",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schemas"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./arkiv": {
      "types": "./dist/arkiv.d.ts",
      "import": "./dist/arkiv.js"
    },
    "./qarinah": {
      "types": "./dist/qarinah.d.ts",
      "import": "./dist/qarinah.js"
    },
    "./graph": {
      "types": "./dist/graph.d.ts",
      "import": "./dist/graph.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    }
  },
  "bin": {
    "app-passport": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/arkiv.ts src/qarinah.ts src/cli.ts src/graph.ts src/tools.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "viem": "2.57.5",
    "zod": "4.1.0",
    "@ajnasnb/arkiv-graph": "0.4.0"
  },
  "peerDependencies": {
    "qarinah": ">=0.6.0 <0.8.0"
  },
  "peerDependenciesMeta": {
    "qarinah": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "8.5.0"
  },
  "author": "Ajnas NB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjnasNB/arkiv-graph.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://arkivgraph.ajnasnb.com/",
  "bugs": {
    "url": "https://github.com/AjnasNB/arkiv-graph/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "arkiv",
    "graph",
    "ai",
    "mcp",
    "evidence"
  ]
}
