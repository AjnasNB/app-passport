{
  "name": "@ajnasnb/arkiv-graph",
  "version": "0.4.1",
  "description": "Signed graph manifests, typed relationships and bounded independent readers on Arkiv.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "schemas",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js"
    },
    "./trust": {
      "types": "./dist/trust.d.ts",
      "import": "./dist/trust.js"
    }
  },
  "bin": {
    "arkiv-graph": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/context.ts src/trust.ts src/cli.ts --format esm --dts --clean"
  },
  "dependencies": {
    "@arkiv-network/sdk": "0.8.1",
    "viem": "2.57.5",
    "zod": "4.1.0",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "tsup": "8.5.0"
  },
  "author": "Ajnas NB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjnasNB/arkiv-graph.git",
    "directory": "packages/arkiv-graph"
  },
  "homepage": "https://arkivgraph.ajnasnb.com/",
  "bugs": {
    "url": "https://github.com/AjnasNB/arkiv-graph/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "arkiv",
    "graph",
    "ai",
    "mcp",
    "evidence"
  ]
}
