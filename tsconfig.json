{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "packages/arkiv-graph/src",
    "packages/sdk/src",
    "apps/web/src",
    "scripts",
    "worker",
    "tests",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor"
  ]
}
